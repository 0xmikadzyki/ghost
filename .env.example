# Copy to .env (chmod 600). Never commit .env. Values are never printed by the tool.

# Envio HyperSync API token (free): https://envio.dev/app/api-tokens
# Required by `rhflow backfill`. The limit is per account: 8 parallel shards stay under it.
ENVIO_TOKEN=

# Optional overrides
# HYPERSYNC_URL=https://robinhood.hypersync.xyz
# RPC_URL=https://rpc.mainnet.chain.robinhood.com      # used by rhflow.research.* only
